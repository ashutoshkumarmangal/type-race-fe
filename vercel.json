# Vercel config for the TypeRush frontend.
#
# The project is detected as Vite automatically; this file just makes the contract explicit so the
# build output is never mis-detected.

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}